{
  "name": "wazcom",
  "description": "Wazobia Technologies Component Library",
  "version": "1.0.0",
  "private": true,
  "entry_point": "index.tsx",
  "dependencies": {
    "@apollo/client": "^3.4.11",
    "@paypal/react-paypal-js": "^7.3.3",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/react-dom": "^17.0.9",
    "@types/react-router-dom": "^5.1.7",
    "chart.js": "^3.5.1",
    "classnames": "^2.3.1",
    "graphql": "^15.6.0",
    "lodash.startcase": "^4.4.0",
    "react-chartjs-2": "^3.0.4",
    "react-icons": "^4.2.0",
    "react-scripts": "^4.0.3",
    "react-toastify": "^8.0.2",
    "typescript": "^4.3.4",
    "universal-cookie": "^4.0.4",
    "web-vitals": "^1.0.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "react-scripts start",
    "test": "jest -c jest.config.json",
    "test:coverage": "jest test --coverage --runInBand --watchAll=false",
    "lint": "eslint 'src/**/*.{ts,js,tsx}' -c .eslintrc.json",
    "lint-fix": "eslint --fix 'src/**/*.{ts,js,tsx}' -c .eslintrc.json",
    "lint-check": "eslint 'src/**/*.{ts,js,tsx}' -c .eslintrc-prod.json",
    "config-check": "eslint --print-config 'src/**/*.{ts,js,tsx}' -c .eslintrc.json | eslint-config-prettier-check",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}'",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@material-ui/core": "^4.11.4",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.60",
    "@material-ui/styles": "^4.11.4",
    "@react-theming/storybook-addon": "^1.1.1",
    "@storybook/addon-actions": "^6.3.7",
    "@storybook/addon-essentials": "^6.3.7",
    "@storybook/addon-links": "^6.3.7",
    "@storybook/node-logger": "^6.3.7",
    "@storybook/preset-create-react-app": "^3.2.0",
    "@storybook/react": "^6.3.7",
    "@types/cookie-parser": "^1.4.2",
    "@types/enzyme": "^3.10.8",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/lodash": "^4.14.172",
    "@types/react": "^17.0.20",
    "@types/react-test-renderer": "^17.0.1",
    "@typescript-eslint/eslint-plugin": "^4.28.1",
    "@typescript-eslint/parser": "^4.28.1",
    "eslint": "^7.29.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "jss-plugin-extend": "^10.7.1",
    "prettier": "^2.3.2",
    "prettier-eslint": "^12.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^4.0.3",
    "react-test-renderer": "^17.0.2",
    "storybook": "^6.3.8",
    "storybook-addon-material-ui": "^0.9.0-alpha.24",
    "ts-jest": "^27.0.3",
    "typescript-eslint": "^0.0.1-alpha.0"
  },
  "peerDependencies": {
    "@material-ui/core": "^4.11.4",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.60",
    "@material-ui/styles": "^4.11.4",
    "jss-plugin-extend": "^10.7.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  }
}
